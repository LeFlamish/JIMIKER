# 이 파일을 key.properties로 복사한 뒤 값을 채우면
# 릴리스 빌드가 업로드 키로 서명된다. (key.properties는 깃에 안 올라간다)
#
# 키 만들기:
#   keytool -genkey -v -keystore C:/keys/jimiker-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# ⚠️ .jks 파일은 저장소 바깥에 두고 비밀번호와 함께 백업할 것.
#    잃어버리면 앱 업데이트를 영원히 못 한다.
#
# 경로는 절대경로로, 윈도우에서도 슬래시(/)를 쓴다.

storeFile=C:/keys/jimiker-upload.jks
storePassword=여기에_키스토어_비밀번호
keyAlias=upload
keyPassword=여기에_키_비밀번호
